#!/bin/sh
# PetraOS kernel userspace init (PID 1).
#
# Runs from the lightweight initramfs as /init. Mounts essential pseudo-filesystems,
# discovers and mounts the persistent ext4 rootfs from /dev/sda (or /dev/vda) onto /sysroot,
# prepares virtual filesystems inside /sysroot, and transitions into the full
# Void Linux rootfs environment.
# If no block device rootfs is available, falls back to the in-memory recovery shell.

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root
export USER=root
export LOGNAME=root
export TERM=linux
export SHELL=/bin/bash
export XDG_CONFIG_HOME=/root/.config
export CHARSET=UTF-8
export LANG=C.UTF-8
export LC_ALL=C.UTF-8

# 1. Mount essential pseudo-filesystems in early initramfs
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mount -t devfs devfs /dev 2>/dev/null || true
mount -t tmpfs tmpfs /tmp 2>/dev/null || true
mount -t tmpfs tmpfs /run 2>/dev/null || true
mkdir -p /dev/pts /dev/shm /root/.config 2>/dev/null || true
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t tmpfs tmpfs /dev/shm 2>/dev/null || true

# Standard file descriptors and symlinks
[ -e /dev/fd ] || ln -sf /proc/self/fd /dev/fd 2>/dev/null || true
[ -e /dev/stdin ] || ln -sf /proc/self/fd/0 /dev/stdin 2>/dev/null || true
[ -e /dev/stdout ] || ln -sf /proc/self/fd/1 /dev/stdout 2>/dev/null || true
[ -e /dev/stderr ] || ln -sf /proc/self/fd/2 /dev/stderr 2>/dev/null || true
[ -e /dev/ptmx ] || ln -sf pts/ptmx /dev/ptmx 2>/dev/null || true
[ -e /etc/mtab ] || ln -sf /proc/self/mounts /etc/mtab 2>/dev/null || true

# Ensure essential device nodes exist
[ -e /dev/null ] || mknod -m 666 /dev/null c 1 3 2>/dev/null || true
[ -e /dev/zero ] || mknod -m 666 /dev/zero c 1 5 2>/dev/null || true
[ -e /dev/tty ] || mknod -m 666 /dev/tty c 5 0 2>/dev/null || true
[ -e /dev/console ] || mknod -m 600 /dev/console c 5 1 2>/dev/null || true
[ -e /dev/sda ] || mknod -m 660 /dev/sda b 8 0 2>/dev/null || true
[ -e /dev/sdb ] || mknod -m 660 /dev/sdb b 8 16 2>/dev/null || true
[ -e /dev/vda ] || mknod -m 660 /dev/vda b 254 0 2>/dev/null || true

# ----------------------------------------------------------------------------
# 2. Mount persistent rootfs block device (/dev/sda or /dev/vda) onto /sysroot
# ----------------------------------------------------------------------------
mkdir -p /sysroot /mnt/rootfs 2>/dev/null || true

ROOT_DEV=""
for candidate in /dev/sda /dev/vda sda vda; do
    echo "[init] Probing block device candidate: $candidate..."
    if mount -t ext4 "$candidate" /sysroot 2>/dev/null; then
        ROOT_DEV="$candidate"
        echo "[init] Successfully mounted persistent rootfs ($ROOT_DEV) on /sysroot"
        break
    fi
done

if [ -n "$ROOT_DEV" ]; then
    ln -sfn /sysroot /mnt/rootfs 2>/dev/null || true

    # Mount virtual filesystems inside sysroot
    mount -t devtmpfs devtmpfs /sysroot/dev 2>/dev/null || mount -t devfs devfs /sysroot/dev 2>/dev/null || true
    mount -t proc proc /sysroot/proc 2>/dev/null || true
    mount -t sysfs sysfs /sysroot/sys 2>/dev/null || true
    mount -t tmpfs tmpfs /sysroot/tmp 2>/dev/null || true
    mount -t tmpfs tmpfs /sysroot/run 2>/dev/null || true
    mkdir -p /sysroot/dev/pts /sysroot/dev/shm /sysroot/root/.config 2>/dev/null || true
    mount -t devpts devpts /sysroot/dev/pts 2>/dev/null || true
    mount -t tmpfs tmpfs /sysroot/dev/shm 2>/dev/null || true

    # Convenience device nodes & symlinks inside sysroot
    [ -e /sysroot/dev/null ] || mknod -m 666 /sysroot/dev/null c 1 3 2>/dev/null || true
    [ -e /sysroot/dev/zero ] || mknod -m 666 /sysroot/dev/zero c 1 5 2>/dev/null || true
    [ -e /sysroot/dev/tty ] || mknod -m 666 /sysroot/dev/tty c 5 0 2>/dev/null || true
    [ -e /sysroot/dev/console ] || mknod -m 600 /sysroot/dev/console c 5 1 2>/dev/null || true
    [ -e /sysroot/dev/ptmx ] || ln -sf pts/ptmx /sysroot/dev/ptmx 2>/dev/null || true
    [ -e /sysroot/dev/fd ] || ln -sf /proc/self/fd /sysroot/dev/fd 2>/dev/null || true
    [ -e /sysroot/dev/stdin ] || ln -sf /proc/self/fd/0 /sysroot/dev/stdin 2>/dev/null || true
    [ -e /sysroot/dev/stdout ] || ln -sf /proc/self/fd/1 /sysroot/dev/stdout 2>/dev/null || true
    [ -e /sysroot/dev/stderr ] || ln -sf /proc/self/fd/2 /sysroot/dev/stderr 2>/dev/null || true
    [ -e /sysroot/etc/mtab ] || ln -sf /proc/self/mounts /sysroot/etc/mtab 2>/dev/null || true

    # Generate ld.so.cache if ldconfig is present
    if [ -x /sysroot/sbin/ldconfig ] || [ -x /sysroot/usr/bin/ldconfig ]; then
        chroot /sysroot ldconfig 2>/dev/null || true
    fi

    echo ""
    echo "============================================================"
    echo "    Welcome to PetraOS (Void Linux userspace glibc)         "
    echo "============================================================"
    echo "Kernel:       $(cat /proc/version 2>/dev/null || echo 'PetraOS x86_64')"
    echo "Release:      PetraOS $(cat /sysroot/etc/petraos-release 2>/dev/null || echo '0.1.0')"
    echo "Rootfs:       $ROOT_DEV (ext4) mounted on /"
    echo "Uptime:       $(cut -d' ' -f1 /proc/uptime 2>/dev/null || echo 0)s"
    echo "Architecture: $(uname -m 2>/dev/null || echo x86_64)"
    echo "============================================================"
    echo ""

    # Unpack OSDK init_args ("sh", "-l")
    if [ "$1" = "sh" ]; then
        if [ "$2" = "-l" ]; then
            shift 2
        else
            shift 1
        fi
    fi

    if [ $# -gt 0 ] && [ "$1" != "sh" ]; then
        echo "[init] Executing requested command in rootfs: $*"
        exec chroot /sysroot "$@"
    fi

    # Start runit service supervisor in the background if services are configured
    if [ -d /sysroot/var/service ] && [ -x /sysroot/usr/bin/runsvdir ]; then
        echo "[init] Starting Void Linux runit service supervisor in background..."
        mkdir -p /sysroot/run/runit/runsvdir
        chroot /sysroot /usr/bin/runsvdir -P /var/service &
    fi

    if [ -x /sysroot/usr/bin/bash ]; then
        echo "[init] Spawning interactive login shell (/usr/bin/bash -l)..."
        exec chroot /sysroot /usr/bin/bash -l
    elif [ -x /sysroot/bin/bash ]; then
        echo "[init] Spawning interactive login shell (/bin/bash -l)..."
        exec chroot /sysroot /bin/bash -l
    else
        echo "[init] Spawning interactive login shell (/bin/sh -l)..."
        exec chroot /sysroot /bin/sh -l
    fi
fi

# ----------------------------------------------------------------------------
# 3. Fallback: Initramfs Recovery Shell (only if rootfs is completely absent)
# ----------------------------------------------------------------------------
echo ""
echo "============================================================"
echo "    Welcome to PetraOS (Initramfs Recovery Shell)           "
echo "============================================================"
echo "Kernel:       $(cat /proc/version 2>/dev/null || echo 'PetraOS x86_64')"
echo "Release:      PetraOS $(cat /etc/petraos-release 2>/dev/null || echo 'unknown')"
echo "Rootfs:       initramfs (in-memory recovery)"
echo "Uptime:       $(cut -d' ' -f1 /proc/uptime 2>/dev/null || echo 0)s"
echo "Architecture: $(uname -m 2>/dev/null || echo x86_64)"
echo "============================================================"
echo ""
echo "WARNING: Failed to mount persistent ext4 rootfs on /sysroot."
echo "Entering in-memory recovery shell."
echo ""

if [ $# -gt 0 ] && [ "$1" != "sh" ]; then
    echo "[init] Executing requested command: $*"
    exec "$@"
fi

if [ -x /bin/bash ]; then
    echo "[init] Spawning interactive login shell (/bin/bash -l)..."
    exec /bin/bash -l
elif [ -x /usr/bin/bash ]; then
    echo "[init] Spawning interactive login shell (/usr/bin/bash -l)..."
    exec /usr/bin/bash -l
else
    echo "[init] Spawning interactive login shell (/bin/sh -l)..."
    exec /bin/sh -l
fi
