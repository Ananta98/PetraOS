From 84a0c8b67119f18e974268e219760775d064cfb1 Mon Sep 17 00:00:00 2001
From: Ananta <kusumaananta042@gmail.com>
Date: Wed, 10 Sep 2026 19:00:00 +0700
Subject: [PATCH] feat(petra): add PetraOS support to GNU Autoconf 2.69

Signed-off-by: Ananta <kusumaananta042@gmail.com>
---
 build-aux/config.sub | 1 +
 1 file changed, 1 insertion(+)

diff --git a/build-aux/config.sub b/build-aux/config.sub
index 6f37648..8b15d2a 100755
--- a/build-aux/config.sub
+++ b/build-aux/config.sub
@@ -1368,6 +1368,7 @@ case $os in
               | -os2* | -vos* | -palmos* | -uclinux* | -nucleus* \
               | -morphos* | -superux* | -rtmk* | -rtmk-nova* | -windiss* \
               | -powermax* | -dnix* | -nx6 | -nx7 | -sei* | -dragonfly* \
+              | -petra* \
               | -skyos* | -haiku* | -rdos* | -toppers* | -drops* | -es*)
         # Remember, each alternative MUST END IN *, to match a version number.
                 ;;
