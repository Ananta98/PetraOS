diff --git a/src/detection/memory/memory_petra.c b/src/detection/memory/memory_petra.c
new file mode 100644
index 0000000..bd0fbbe
--- /dev/null
+++ b/src/detection/memory/memory_petra.c
@@ -0,0 +1,17 @@
+#include "memory.h"
+#include <sys/sysinfo.h>
+#include <unistd.h>
+
+const char* ffDetectMemory(FFMemoryResult* ram)
+{
+    struct sysinfo info;
+    if(sysinfo(&info)) {
+        return "sysinfo() failed";
+    }
+
+    uint32_t unit = info.mem_unit ? info.mem_unit : 1;
+    ram->bytesTotal = (uint64_t)info.totalram * unit;
+    ram->bytesUsed = (uint64_t)((info.totalram - info.freeram) * unit);
+
+    return NULL;
+}
