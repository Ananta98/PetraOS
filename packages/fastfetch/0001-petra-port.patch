diff --git a/src/detection/loadavg/loadavg_petra.c b/src/detection/loadavg/loadavg_petra.c
new file mode 100644
index 0000000..762524a
--- /dev/null
+++ b/src/detection/loadavg/loadavg_petra.c
@@ -0,0 +1,15 @@
+#include "loadavg.h"
+
+#include <sys/sysinfo.h>
+
+const char* ffDetectLoadavg(double result[3])
+{
+    struct sysinfo si;
+    if(sysinfo(&si) < 0)
+        return "sysinfo() failed";
+
+    for(int i = 0; i < 3; ++i)
+        result[i] = (double) si.loads[i] / (1 << SI_LOAD_SHIFT);
+
+    return NULL;
+}
