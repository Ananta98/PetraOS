+++ b/src/detection/swap/swap_petra.c
@@ -0,0 +1,19 @@
+#include "swap.h"
+#include <sys/sysinfo.h>
+
+const char* ffDetectSwap(FFlist* result)
+{
+    struct sysinfo info;
+    if(sysinfo(&info)) {
+        return "sysinfo() failed";
+    }
+
+    FFSwapResult* swap = ffListAdd(result);
+    uint32_t unit = info.mem_unit ? info.mem_unit : 1;
+
+    ffStrbufInitStatic(&swap->name, "Total");
+    swap->bytesTotal = (uint64_t)info.totalswap * unit;
+    swap->bytesUsed = (uint64_t)((info.totalswap - info.freeswap) * unit);
+
+    return NULL;
+}
