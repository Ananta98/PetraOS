diff --git a/src/detection/cpu/cpu_petra.c b/src/detection/cpu/cpu_petra.c
new file mode 100644
index 0000000..0814baa
--- /dev/null
+++ b/src/detection/cpu/cpu_petra.c
@@ -0,0 +1,44 @@
+#include "cpu.h"
+#include <cpuid.h>
+
+void cpuid_brand_string(char buffer[49]) {
+    uint32_t regs[12];
+
+    __get_cpuid(0x80000000, regs + 0, regs + 1, regs + 2, regs + 3);
+    if (regs[0] < 0x80000004) {
+        strcpy(buffer, "Unknown");
+        return;
+    }
+
+    __get_cpuid(0x80000002, regs + 0, regs + 1, regs + 2, regs + 3);
+    __get_cpuid(0x80000003, regs + 4, regs + 5, regs + 6, regs + 7);
+    __get_cpuid(0x80000004, regs + 8, regs + 9, regs + 10, regs + 11);
+
+    memcpy(buffer, regs, sizeof(regs));
+    buffer[sizeof(regs)] = '\0';
+}
+
+void cpuid_vendor_string(char buffer[13]) {
+    uint32_t regs[4];
+
+    __get_cpuid(0x0, regs + 3, regs + 0, regs + 2, regs + 1);
+
+    memcpy(buffer, regs, sizeof(uint32_t) * 3);
+    buffer[12] = '\0';
+}
+
+const char* ffDetectCPUImpl(FF_MAYBE_UNUSED const FFCPUOptions* options, FF_MAYBE_UNUSED FFCPUResult* cpu)
+{
+    // Brand/Model
+    char brandBuffer[49];
+    cpuid_brand_string(brandBuffer);
+    ffStrbufSetS(&cpu->name, brandBuffer);
+
+    // Vendor String
+    char vendorBuffer[13];
+    cpuid_vendor_string(vendorBuffer);
+    ffStrbufSetS(&cpu->vendor, vendorBuffer);
+
+    ffCPUDetectByCpuid(cpu);
+    return NULL;
+}
diff --git a/src/detection/disk/disk_petra.c b/src/detection/disk/disk_petra.c
new file mode 100644
index 0000000..7b86f31
--- /dev/null
+++ b/src/detection/disk/disk_petra.c
@@ -0,0 +1,37 @@
+#include "disk.h"
+#include <sys/statvfs.h>
+#include <string.h>
+
+const char* ffDetectDisksImpl(FF_MAYBE_UNUSED FFDiskOptions* options, FFlist* disks)
+{
+    struct statvfs fs;
+    if (statvfs("/", &fs) != 0)
+        return "statvfs(\"/\") failed";
+
+    FFDisk* disk = ffListAdd(disks);
+    disk->type = FF_DISK_VOLUME_TYPE_REGULAR_BIT;
+
+    ffStrbufInitStatic(&disk->mountFrom, "/dev/ramfs");
+    ffStrbufInitStatic(&disk->mountpoint, "/");
+    ffStrbufInitStatic(&disk->filesystem, "ramfs");
+    ffStrbufInitStatic(&disk->name, "root");
+
+    disk->bytesTotal = fs.f_blocks * (uint64_t) fs.f_frsize;
+    disk->bytesFree = fs.f_bfree * (uint64_t) fs.f_frsize;
+    disk->bytesAvailable = fs.f_bavail * (uint64_t) fs.f_frsize;
+    disk->bytesUsed = disk->bytesTotal - disk->bytesFree;
+
+    if(fs.f_files >= fs.f_ffree)
+    {
+        disk->filesTotal = (uint32_t) fs.f_files;
+        disk->filesUsed = (uint32_t) (fs.f_files - fs.f_ffree);
+    }
+    else
+    {
+        disk->filesTotal = 0;
+        disk->filesUsed = 0;
+    }
+
+    disk->createTime = 0;
+    return NULL;
+}
