From 4b8f92317d8597c832896bee57265cfb2e27a3ae Mon Sep 17 00:00:00 2001
From: Ananta <kusumaananta042@gmail.com>
Date: Sat, 15 Aug 2026 21:55:00 +0700
Subject: [PATCH] feat(petra): add PetraOS support to GNU Automake 1.16

Signed-off-by: Ananta <kusumaananta042@gmail.com>
---
 lib/config.guess | 3 +++
 lib/config.sub   | 2 +-
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/lib/config.guess b/lib/config.guess
index 2193702..7b9c18c 100755
--- a/lib/config.guess
+++ b/lib/config.guess
@@ -827,6 +827,9 @@ EOF
     i*86:BSD/386:*:* | i*86:BSD/OS:*:* | *:Ascend\ Embedded/OS:*:*)
 	echo ${UNAME_MACHINE}-pc-bsdi${UNAME_RELEASE}
 	exit ;;
+    *:Petra:*:* | *:petra:*:*)
+	GUESS=$UNAME_MACHINE-pc-petra
+	;;
     sparc*:BSD/OS:*:*)
 	echo sparc-unknown-bsdi${UNAME_RELEASE}
 	exit ;;
diff --git a/lib/config.sub b/lib/config.sub
index d74fb6dea..d60828765 100755
--- a/lib/config.sub
+++ b/lib/config.sub
@@ -1723,7 +1723,7 @@ case $os in
 	     | hpux* | unos* | osf* | luna* | dgux* | auroraux* | solaris* \
 	     | sym* |  plan9* | psp* | sim* | xray* | os68k* | v88r* \
 	     | hiux* | abug | nacl* | netware* | windows* \
-	     | os9* | macos* | osx* | ios* \
+	     | os9* | macos* | osx* | ios* | petra* \
 	     | mpw* | magic* | mmixware* | mon960* | lnews* \
 	     | amigaos* | amigados* | msdos* | newsos* | unicos* | aof* \
 	     | aos* | aros* | cloudabi* | sortix* | twizzler* \
