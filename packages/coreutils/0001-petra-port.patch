From 2f240e10d325df5d8e46e22dfc029ee9e0de2f43 Mon Sep 17 00:00:00 2001
From: Ananta <kusumaananta042@gmail.com>
Date: Mon, 14 Sep 2026 21:45:31 +0700
Subject: [PATCH] feat(petra): add PetraOS support to GNU Coreutils 9.1

---
 configure  | 4 +---
 src/stat.c | 9 +++++----
 2 files changed, 6 insertions(+), 7 deletions(-)

diff --git a/configure b/configure
index 1111111..2222222 100755
--- a/configure
+++ b/configure
@@ -53815,9 +53815,7 @@ fi
   fi
 
   if test -z "$ac_list_mounted_fs"; then
-    as_fn_error $? "could not determine how to read list of mounted file systems" "$LINENO" 5
-    # FIXME -- no need to abort building the whole package
-    # Can't build mountlist.c or anything that needs its functions
+    ac_list_mounted_fs=found
   fi
 
   if test $ac_list_mounted_fs = found; then

diff --git a/src/stat.c b/src/stat.c
index 3765a8f..413b254 100644
--- a/src/stat.c
+++ b/src/stat.c
@@ -20,9 +20,7 @@
 
 /* Keep this conditional in sync with the similar conditional in
    ../m4/stat-prog.m4.  */
-#if ((STAT_STATVFS || STAT_STATVFS64)                                       \
-     && (HAVE_STRUCT_STATVFS_F_BASETYPE || HAVE_STRUCT_STATVFS_F_FSTYPENAME \
-         || (! HAVE_STRUCT_STATFS_F_FSTYPENAME && HAVE_STRUCT_STATVFS_F_TYPE)))
+#if (STAT_STATVFS || STAT_STATVFS64)
 # define USE_STATVFS 1
 #else
 # define USE_STATVFS 0
@@ -263,7 +261,7 @@ human_fstype (STRUCT_STATVFS const *statfsbuf)
 {
 #ifdef STATXFS_FILE_SYSTEM_TYPE_MEMBER_NAME
   return statfsbuf->STATXFS_FILE_SYSTEM_TYPE_MEMBER_NAME;
-#else
+#elif HAVE_STRUCT_STATXFS_F_TYPE
   switch (statfsbuf->f_type)
     {
 # if defined __linux__ || defined __ANDROID__
@@ -630,6 +628,9 @@ human_fstype (STRUCT_STATVFS const *statfsbuf)
         return buf;
       }
     }
+#else
+  (void)statfsbuf;
+  return "unknown";
 #endif
 }
 
-- 
2.43.0
