+#include <sys/select.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <ioctl_defs.h>
+
+namespace mlibc {
+
+int Sysdeps<Isatty>::operator()(int fd) {
+    int64_t ret = __petra_syscall1(SYSCALL_ISATTY, fd);
+    if (ret < 0) {
+        return -ret;
+    }
+    return (ret == 1) ? 0 : ENOTTY;
+}
+
+int Sysdeps<Ioctl>::operator()(int fd, unsigned long request, void *arg, int *result) {
+    int64_t ret = __petra_syscall3(SYSCALL_IOCTL, fd, request, (int64_t)arg);
+    if (ret < 0) {
+        return -ret;
+    }
+    if (result) {
+        *result = ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Tcgetattr>::operator()(int fd, struct termios *attr) {
+    int64_t ret = __petra_syscall3(SYSCALL_IOCTL, fd, IOCTL_TCGETS, (int64_t)attr);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Tcsetattr>::operator()(int fd, int optional_action, const struct termios *attr) {
+    (void)optional_action;
+    int64_t ret = __petra_syscall3(SYSCALL_IOCTL, fd, IOCTL_TCSETS, (int64_t)attr);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Tcgetwinsize>::operator()(int fd, struct winsize *winsz) {
+    int64_t ret = __petra_syscall3(SYSCALL_IOCTL, fd, IOCTL_TIOCGWINSZ, (int64_t)winsz);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Tcsetwinsize>::operator()(int fd, const struct winsize *winsz) {
+    int64_t ret = __petra_syscall3(SYSCALL_IOCTL, fd, IOCTL_TIOCSWINSZ, (int64_t)winsz);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Ttyname>::operator()(int fd, char *buf, size_t size) {
+    if (int e = sysdep<Isatty>(fd); e) {
+        return e;
+    }
+    static const char tty_name[] = "/dev/tty";
+    if (size < sizeof(tty_name)) {
+        return ERANGE;
+    }
+    memcpy(buf, tty_name, sizeof(tty_name));
+    return 0;
+}
+
+#ifndef MLIBC_BUILDING_RTLD
+int Sysdeps<Ptsname>::operator()(int fd, char *buffer, size_t length) {
+    int index = 0;
+    if (int e = sysdep<Ioctl>(fd, IOCTL_TIOCGPTN, &index, nullptr); e) {
+        return e;
+    }
+    if ((size_t)snprintf(buffer, length, "/dev/pts/%d", index) >= length) {
+        return ERANGE;
+    }
+    return 0;
+}
+
+int Sysdeps<Unlockpt>::operator()(int fd) {
+    (void)fd;
+    return 0;
+}
+#endif // !MLIBC_BUILDING_RTLD
+
+int Sysdeps<Tcsendbreak>::operator()(int fd, int duration) {
+    int64_t ret = __petra_syscall3(SYSCALL_IOCTL, fd, IOCTL_TCSBRK, (int64_t)duration);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Tcflow>::operator()(int fd, int action) {
+    int64_t ret = __petra_syscall3(SYSCALL_IOCTL, fd, IOCTL_TCXONC, (int64_t)action);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Tcflush>::operator()(int fd, int queue) {
+    int64_t ret = __petra_syscall3(SYSCALL_IOCTL, fd, IOCTL_TCFLSH, (int64_t)queue);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Ppoll>::operator()(struct pollfd *fds, nfds_t count, const struct timespec *timeout, const sigset_t *sigmask, int *num_events) {
+    int64_t ret = __petra_syscall5(SYSCALL_PPOLL, (int64_t)fds, count, (int64_t)timeout, (int64_t)sigmask, sizeof(sigset_t));
+    if (ret < 0) {
+        return -ret;
+    }
+    if (num_events) {
+        *num_events = ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Poll>::operator()(struct pollfd *fds, nfds_t count, int timeout, int *num_events) {
+    int64_t ret = __petra_syscall3(SYSCALL_POLL, (int64_t)fds, count, timeout);
+    if (ret < 0) {
+        return -ret;
+    }
+    if (num_events) {
+        *num_events = ret;
+    }
+    return 0;
+}
+
+#ifndef MLIBC_BUILDING_RTLD
+int Sysdeps<Pselect>::operator()(int nfds, fd_set *read_set, fd_set *write_set,
+        fd_set *except_set, const struct timespec *timeout,
+        const sigset_t *sigmask, int *num_events) {
+    if (nfds <= 0) {
+        if (num_events) {
+            *num_events = 0;
+        }
+        return 0;
+    }
+
+    struct pollfd *fds = static_cast<struct pollfd *>(malloc(nfds * sizeof(struct pollfd)));
+    if (!fds) {
+        return ENOMEM;
+    }
+
+    int actual_count = 0;
+    for (int fd = 0; fd < nfds; fd++) {
+        short events = 0;
+        if (read_set && FD_ISSET(fd, read_set)) {
+            events |= POLLIN;
+        }
+        if (write_set && FD_ISSET(fd, write_set)) {
+            events |= POLLOUT;
+        }
+        if (except_set && FD_ISSET(fd, except_set)) {
+            events |= POLLPRI;
+        }
+        if (events) {
+            fds[actual_count].fd = fd;
+            fds[actual_count].events = events;
+            fds[actual_count].revents = 0;
+            actual_count++;
+        }
+    }
+
+    int num;
+    int err = sysdep<Ppoll>(fds, actual_count, timeout, sigmask, &num);
+    if (err) {
+        free(fds);
+        return err;
+    }
+
+    int return_count = 0;
+    for (int i = 0; i < actual_count; i++) {
+        int events = fds[i].events;
+        if ((events & POLLIN) && (fds[i].revents & (POLLIN | POLLHUP | POLLERR)) == 0) {
+            FD_CLR(fds[i].fd, read_set);
+            events &= ~POLLIN;
+        }
+        if ((events & POLLOUT) && (fds[i].revents & (POLLOUT | POLLERR)) == 0) {
+            FD_CLR(fds[i].fd, write_set);
+            events &= ~POLLOUT;
+        }
+        if ((events & POLLPRI) && (fds[i].revents & POLLPRI) == 0) {
+            FD_CLR(fds[i].fd, except_set);
+            events &= ~POLLPRI;
+        }
+        if (events) {
+            return_count++;
+        }
+    }
+    if (num_events) {
+        *num_events = return_count;
+    }
+    free(fds);
+    return 0;
+}
+#endif /* !MLIBC_BUILDING_RTLD */
+
+} // namespace mlibc
