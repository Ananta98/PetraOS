 sysdeps/petra/generic/generic.cpp | 86 +++++++++++++++++++++++++++++++
 sysdeps/petra/meson.build         |  1 +
 2 files changed, 87 insertions(+)

diff --git a/sysdeps/petra/generic/generic.cpp b/sysdeps/petra/generic/generic.cpp
index c8493d43..12ef809c 100644
--- a/sysdeps/petra/generic/generic.cpp
+++ b/sysdeps/petra/generic/generic.cpp
@@ -15,6 +15,9 @@
 #include <mlibc/tcb.hpp>
 #include <sys/types.h>
 #include <sys/stat.h>
+#include <sys/select.h>
+#include <termios.h>
+#include <poll.h>
 #include <stddef.h>
 
 namespace mlibc {
@@ -458,4 +461,87 @@ int Sysdeps<Sleep>::operator()(time_t *secs, long *nanos) {
     return 0;
 }
 
+int Sysdeps<Tcgetattr>::operator()(int fd, struct termios *attr) {
+    int64_t ret = __petra_syscall3(SYSCALL_IOCTL, fd, 0x5401 /* TCGETS */, (int64_t)attr);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Tcsetattr>::operator()(int fd, int optional_action, const struct termios *attr) {
+    (void)optional_action;
+    int64_t ret = __petra_syscall3(SYSCALL_IOCTL, fd, 0x5402 /* TCSETS */, (int64_t)attr);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Tcsendbreak>::operator()(int fd, int) {
+    (void)fd;
+    return 0;
+}
+
+int Sysdeps<Tcflow>::operator()(int fd, int action) {
+    (void)fd;
+    (void)action;
+    return 0;
+}
+
+int Sysdeps<Tcflush>::operator()(int fd, int queue) {
+    (void)fd;
+    (void)queue;
+    return 0;
+}
+
+int Sysdeps<Ppoll>::operator()(struct pollfd *fds, nfds_t count, const struct timespec *timeout, const sigset_t *sigmask, int *num_events) {
+    (void)timeout;
+    (void)sigmask;
+    int ready = 0;
+    for (nfds_t i = 0; i < count; i++) {
+        fds[i].revents = fds[i].events & (POLLIN | POLLOUT);
+        if (fds[i].revents) {
+            ready++;
+        }
+    }
+    if (num_events) {
+        *num_events = ready;
+    }
+    return 0;
+}
+
+int Sysdeps<Poll>::operator()(struct pollfd *fds, nfds_t count, int timeout, int *num_events) {
+    (void)timeout;
+    return sysdep<Ppoll>(fds, count, NULL, NULL, num_events);
+}
+
+int Sysdeps<Pselect>::operator()(int nfds, fd_set *read_set, fd_set *write_set,
+        fd_set *except_set, const struct timespec *timeout,
+        const sigset_t *sigmask, int *num_events) {
+    (void)except_set;
+    (void)timeout;
+    (void)sigmask;
+    int ready = 0;
+    for (int i = 0; i < nfds; i++) {
+        if (read_set && FD_ISSET(i, read_set)) {
+            ready++;
+        }
+        if (write_set && FD_ISSET(i, write_set)) {
+            ready++;
+        }
+    }
+    if (num_events) {
+        *num_events = ready;
+    }
+    return 0;
+}
+
+int Sysdeps<Sigpending>::operator()(sigset_t *set) {
+    if (set) {
+        *set = 0;
+    }
+    return 0;
+}
+
 } // namespace mlibc
