+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Fork>::operator()(pid_t *child) {
+    int64_t ret = __petra_syscall0(SYSCALL_FORK);
+    if (ret < 0) {
+        return -ret;
+    }
+    *child = ret;
+    return 0;
+}
+
+int Sysdeps<Execve>::operator()(const char *path, char *const argv[], char *const envp[]) {
+    int64_t ret = __petra_syscall3(SYSCALL_EXECVE, (int64_t)path, (int64_t)argv, (int64_t)envp);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Waitpid>::operator()(pid_t pid, int *status, int flags, struct rusage *ru, pid_t *ret_pid) {
+    int64_t ret = __petra_syscall4(SYSCALL_WAIT4, pid, (int64_t)status, flags, (int64_t)ru);
+    if (ret < 0) {
+        return -ret;
+    }
+    *ret_pid = ret;
+    return 0;
+}
+
+int Sysdeps<FutexWait>::operator()(int *pointer, int expected, const struct timespec *time) {
+    int64_t ret = __petra_syscall4(SYSCALL_FUTEX, (int64_t)pointer, 0 /* FUTEX_WAIT */, expected, (int64_t)time);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<FutexWake>::operator()(int *pointer, bool all) {
+    int64_t val = all ? INT_MAX : 1;
+    int64_t ret = __petra_syscall3(SYSCALL_FUTEX, (int64_t)pointer, 1 /* FUTEX_WAKE */, val);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<ClockGet>::operator()(int clock, time_t *secs, long *nanos) {
+    // Fallback to gettimeofday
+    struct {
+        int64_t tv_sec;
+        int64_t tv_usec;
+    } tv;
+    int64_t ret = __petra_syscall2(SYSCALL_GETTIMEOFDAY, (int64_t)&tv, 0);
+    if (ret < 0) {
+        return -ret;
+    }
+    *secs = tv.tv_sec;
+    *nanos = tv.tv_usec * 1000;
+    return 0;
+}
+
+int Sysdeps<Stat>::operator()(fsfd_target fsfdt, int fd, const char *path, int flags, struct stat *statbuf) {
+    int64_t ret;
+    switch (fsfdt) {
+        case fsfd_target::fd:
+            ret = __petra_syscall2(SYSCALL_FSTAT, fd, (int64_t)statbuf);
+            break;
+        case fsfd_target::path:
+            ret = __petra_syscall2(SYSCALL_STAT, (int64_t)path, (int64_t)statbuf);
+            break;
+        case fsfd_target::fd_path:
+            ret = __petra_syscall4(SYSCALL_NEWFSTATAT, fd, (int64_t)path, (int64_t)statbuf, flags);
+            break;
+        default:
+            return EINVAL;
+    }
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Fcntl>::operator()(int fd, int request, va_list args, int *result) {
+    int64_t arg = va_arg(args, int64_t);
+    int64_t ret = __petra_syscall3(SYSCALL_FCNTL, fd, request, arg);
+    if (ret < 0) {
+        return -ret;
+    }
+    if (result) {
+        *result = ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Dup>::operator()(int fd, int flags, int *newfd) {
+    (void)flags;
+    int64_t ret = __petra_syscall1(SYSCALL_DUP, fd);
+    if (ret < 0) {
+        return -ret;
+    }
+    *newfd = ret;
+    return 0;
+}
+
+int Sysdeps<Dup2>::operator()(int fd, int flags, int newfd) {
+    (void)flags;
+    int64_t ret = __petra_syscall2(SYSCALL_DUP2, fd, newfd);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Pipe>::operator()(int *fds, int flags) {
+    int64_t ret;
+    if (flags) {
+        ret = __petra_syscall2(SYSCALL_PIPE2, (int64_t)fds, flags);
+    } else {
+        ret = __petra_syscall1(SYSCALL_PIPE, (int64_t)fds);
+    }
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+void Sysdeps<Yield>::operator()() {
+    __petra_syscall0(SYSCALL_YIELD);
+}
+
+int Sysdeps<Kill>::operator()(pid_t pid, int sig) {
+    int64_t ret = __petra_syscall2(SYSCALL_KILL, pid, sig);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Sigaction>::operator()(int sig, const struct sigaction *__restrict act, struct sigaction *__restrict oldact) {
+    int64_t ret = __petra_syscall4(SYSCALL_RT_SIGACTION, sig, (int64_t)act, (int64_t)oldact, sizeof(sigset_t));
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Sigprocmask>::operator()(int how, const sigset_t *__restrict set, sigset_t *__restrict retrieve) {
+    int64_t ret = __petra_syscall4(SYSCALL_RT_SIGPROCMASK, how, (int64_t)set, (int64_t)retrieve, sizeof(sigset_t));
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Chdir>::operator()(const char *path) {
+    int64_t ret = __petra_syscall1(SYSCALL_CHDIR, (int64_t)path);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<GetCwd>::operator()(char *buffer, size_t size) {
+    int64_t ret = __petra_syscall2(SYSCALL_GETCWD, (int64_t)buffer, size);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Sleep>::operator()(time_t *secs, long *nanos) {
+    int dummy = 0;
+    struct timespec ts;
+    ts.tv_sec = *secs;
+    ts.tv_nsec = *nanos;
+    __petra_syscall4(SYSCALL_FUTEX, (int64_t)&dummy, 0 /* FUTEX_WAIT */, 0, (int64_t)&ts);
+    *secs = 0;
+    *nanos = 0;
+    return 0;
+}
