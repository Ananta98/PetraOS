diff --git a/sysdeps/petra/include/mlibc/sysdeps.hpp b/sysdeps/petra/include/mlibc/sysdeps.hpp
new file mode 100644
index 000000000..5681c78f3
--- /dev/null
+++ b/sysdeps/petra/include/mlibc/sysdeps.hpp
@@ -0,0 +1,69 @@
+#pragma once
+
+#include <mlibc/sysdep-signatures.hpp>
+
+namespace mlibc {
+
+struct PetraSysdepTags :
+    LibcPanic,
+    LibcLog,
+    Exit,
+    TcbSet,
+    AnonAllocate,
+    AnonFree,
+    VmMap,
+    VmUnmap,
+    VmProtect,
+    Write,
+    Read,
+    Open,
+    Openat,
+    Close,
+    Seek,
+    Isatty,
+    Ioctl,
+    GetPid,
+    GetPpid,
+    GetPgid,
+    SetPgid,
+    Fork,
+    Execve,
+    Waitpid,
+    FutexWait,
+    FutexWake,
+    ClockGet,
+    Stat,
+    Fcntl,
+    Dup,
+    Dup2,
+    Pipe,
+    Yield,
+    Kill,
+    Sigaction,
+    Sigprocmask,
+    GetUid,
+    GetEuid,
+    GetGid,
+    GetEgid,
+    SetUid,
+    SetGid,
+    SetSid,
+    GetGroups,
+    GetRlimit,
+    SetRlimit,
+    Access,
+    Faccessat,
+    Umask,
+    Chdir,
+    GetCwd,
+    Sleep
+{};
+
+template<typename Tag>
+using Sysdeps = SysdepOf<PetraSysdepTags, Tag>;
+
+struct SysdepTraits {
+    static constexpr bool usesRtNetlink = false;
+};
+
+} // namespace mlibc
diff --git a/sysdeps/petra/include/sys/syscall.h b/sysdeps/petra/include/sys/syscall.h
new file mode 100644
index 000000000..88915e85d
--- /dev/null
+++ b/sysdeps/petra/include/sys/syscall.h
@@ -0,0 +1,119 @@
+#ifndef _SYS_SYSCALL_H
+#define _SYS_SYSCALL_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+#define SYSCALL_READ           0
+#define SYSCALL_WRITE          1
+#define SYSCALL_OPEN           2
+#define SYSCALL_CLOSE          3
+#define SYSCALL_STAT           4
+#define SYSCALL_FSTAT          5
+#define SYSCALL_LSEEK          8
+#define SYSCALL_MMAP           9
+#define SYSCALL_MPROTECT       10
+#define SYSCALL_MUNMAP         11
+#define SYSCALL_BRK            12
+#define SYSCALL_RT_SIGACTION   13
+#define SYSCALL_RT_SIGPROCMASK 14
+#define SYSCALL_RT_SIGRETURN   15
+#define SYSCALL_IOCTL          16
+#define SYSCALL_ACCESS         21
+#define SYSCALL_PIPE           22
+#define SYSCALL_YIELD          24
+#define SYSCALL_DUP            32
+#define SYSCALL_DUP2           33
+#define SYSCALL_NANOSLEEP      35
+#define SYSCALL_GETPID         39
+#define SYSCALL_FORK           57
+#define SYSCALL_VFORK          58
+#define SYSCALL_EXECVE         59
+#define SYSCALL_EXIT           60
+#define SYSCALL_WAIT4          61
+#define SYSCALL_KILL           62
+#define SYSCALL_UNAME          63
+#define SYSCALL_FCNTL          72
+#define SYSCALL_GETCWD         79
+#define SYSCALL_CHDIR          80
+#define SYSCALL_UMASK          95
+#define SYSCALL_GETTIMEOFDAY   96
+#define SYSCALL_GETRLIMIT      97
+#define SYSCALL_TIMES          100
+#define SYSCALL_GETUID         102
+#define SYSCALL_GETGID         104
+#define SYSCALL_SETUID         105
+#define SYSCALL_SETGID         106
+#define SYSCALL_GETEUID        107
+#define SYSCALL_GETEGID        108
+#define SYSCALL_SETPGID        109
+#define SYSCALL_GETPPID        110
+#define SYSCALL_GETPGRP        111
+#define SYSCALL_SETSID         112
+#define SYSCALL_GETGROUPS      115
+#define SYSCALL_ARCH_PRCTL     158
+#define SYSCALL_SETRLIMIT      160
+#define SYSCALL_FUTEX          202
+#define SYSCALL_ISATTY         215
+#define SYSCALL_CLOCK_GETTIME  228
+#define SYSCALL_EXIT_GROUP     231
+#define SYSCALL_OPENAT         257
+#define SYSCALL_NEWFSTATAT     262
+#define SYSCALL_FACCESSAT      269
+#define SYSCALL_DUP3           292
+#define SYSCALL_PIPE2          293
+#define SYSCALL_PRLIMIT64      302
+
+#if defined(__x86_64__)
+
+static inline int64_t __petra_syscall0(int64_t sc) {
+    int64_t ret;
+    asm volatile ("syscall" : "=a"(ret) : "a"(sc) : "rcx", "r11", "memory");
+    return ret;
+}
+
+static inline int64_t __petra_syscall1(int64_t sc, int64_t a1) {
+    int64_t ret;
+    asm volatile ("syscall" : "=a"(ret) : "a"(sc), "D"(a1) : "rcx", "r11", "memory");
+    return ret;
+}
+
+static inline int64_t __petra_syscall2(int64_t sc, int64_t a1, int64_t a2) {
+    int64_t ret;
+    asm volatile ("syscall" : "=a"(ret) : "a"(sc), "D"(a1), "S"(a2) : "rcx", "r11", "memory");
+    return ret;
+}
+
+static inline int64_t __petra_syscall3(int64_t sc, int64_t a1, int64_t a2, int64_t a3) {
+    int64_t ret;
+    asm volatile ("syscall" : "=a"(ret) : "a"(sc), "D"(a1), "S"(a2), "d"(a3) : "rcx", "r11", "memory");
+    return ret;
+}
+
+static inline int64_t __petra_syscall4(int64_t sc, int64_t a1, int64_t a2, int64_t a3, int64_t a4) {
+    int64_t ret;
+    register int64_t r10 asm("r10") = a4;
+    asm volatile ("syscall" : "=a"(ret) : "a"(sc), "D"(a1), "S"(a2), "d"(a3), "r"(r10) : "rcx", "r11", "memory");
+    return ret;
+}
+
+static inline int64_t __petra_syscall5(int64_t sc, int64_t a1, int64_t a2, int64_t a3, int64_t a4, int64_t a5) {
+    int64_t ret;
+    register int64_t r10 asm("r10") = a4;
+    register int64_t r8 asm("r8") = a5;
+    asm volatile ("syscall" : "=a"(ret) : "a"(sc), "D"(a1), "S"(a2), "d"(a3), "r"(r10), "r"(r8) : "rcx", "r11", "memory");
+    return ret;
+}
+
+static inline int64_t __petra_syscall6(int64_t sc, int64_t a1, int64_t a2, int64_t a3, int64_t a4, int64_t a5, int64_t a6) {
+    int64_t ret;
+    register int64_t r10 asm("r10") = a4;
+    register int64_t r8 asm("r8") = a5;
+    register int64_t r9 asm("r9") = a6;
+    asm volatile ("syscall" : "=a"(ret) : "a"(sc), "D"(a1), "S"(a2), "d"(a3), "r"(r10), "r"(r8), "r"(r9) : "rcx", "r11", "memory");
+    return ret;
+}
+
+#endif
+
+#endif /* _SYS_SYSCALL_H */
