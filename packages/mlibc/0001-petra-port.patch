+void Sysdeps<LibcLog>::operator()(const char *message) {
+    ssize_t unused;
+    sysdep<Write>(2, message, strlen(message), &unused);
+    sysdep<Write>(2, "\n", 1, &unused);
+
+    static bool logging_file = false;
+    if (!logging_file) {
+        logging_file = true;
+        int fd = -1;
+        if (sysdep<Open>("/tmp/mlibc.log", O_WRONLY | O_CREAT | O_APPEND, 0666, &fd) != 0 || fd < 0) {
+            sysdep<Open>("/mlibc.log", O_WRONLY | O_CREAT | O_APPEND, 0666, &fd);
+        }
+        if (fd >= 0) {
+            sysdep<Write>(fd, message, strlen(message), &unused);
+            sysdep<Write>(fd, "\n", 1, &unused);
+            sysdep<Close>(fd);
+        }
+        logging_file = false;
+    }
+}
+
+void Sysdeps<LibcPanic>::operator()() {
+    ssize_t unused;
+    char const *message = "\n[PetraOS] mlibc panic occurred!\n";
+    sysdep<Write>(2, message, strlen(message), &unused);
+
+    static bool logging_file = false;
+    if (!logging_file) {
+        logging_file = true;
+        int fd = -1;
+        if (sysdep<Open>("/tmp/mlibc.log", O_WRONLY | O_CREAT | O_APPEND, 0666, &fd) != 0 || fd < 0) {
+            sysdep<Open>("/mlibc.log", O_WRONLY | O_CREAT | O_APPEND, 0666, &fd);
+        }
+        if (fd >= 0) {
+            sysdep<Write>(fd, message, strlen(message), &unused);
+            sysdep<Close>(fd);
