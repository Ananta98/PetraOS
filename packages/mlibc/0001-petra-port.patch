+int Sysdeps<Ttyname>::operator()(int fd, char *buf, size_t size) {
+    if (int e = sysdep<Isatty>(fd); e) {
+        return e;
+    }
+    static const char tty_name[] = "/dev/tty";
+    if (size < sizeof(tty_name)) {
+        return ERANGE;
+    }
+    memcpy(buf, tty_name, sizeof(tty_name));
+    return 0;
+}
+
+int Sysdeps<GetHostname>::operator()(char *buffer, size_t bufsize) {
+    if (bufsize == 0) {
+        return 0;
+    }
+    struct utsname uts;
+    const char *name = "petraos";
+    int64_t ret = __petra_syscall1(SYSCALL_UNAME, (int64_t)&uts);
+    if (ret >= 0 && uts.nodename[0] != '\0') {
+        name = uts.nodename;
+    }
+    size_t len = strlen(name);
+    size_t copy = (len < bufsize) ? len : bufsize - 1;
+    memcpy(buffer, name, copy);
+    buffer[copy] = '\0';
+    return 0;
+}
