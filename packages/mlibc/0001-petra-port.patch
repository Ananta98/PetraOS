+#include <bits/ensure.h>
+#include <mlibc/debug.hpp>
+#include <mlibc/all-sysdeps.hpp>
+#include <errno.h>
+#include <time.h>
+#include <sys/time.h>
+#include <sys/times.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <sys_defs.h>
+
+namespace mlibc {
+
+int Sysdeps<ClockGet>::operator()(int clock, time_t *secs, long *nanos) {
+    struct timespec ts;
+    int64_t ret = __petra_syscall2(SYSCALL_CLOCK_GETTIME, clock, (int64_t)&ts);
+    if (ret < 0) {
+        return -ret;
+    }
+    *secs = ts.tv_sec;
+    *nanos = ts.tv_nsec;
+    return 0;
+}
+
+int Sysdeps<ClockGetres>::operator()(int clock, time_t *secs, long *nanos) {
+    (void)clock;
+    if (secs) *secs = 0;
+    if (nanos) *nanos = DEFAULT_CLOCK_RES_NSEC;
+    return 0;
+}
+
+int Sysdeps<Sleep>::operator()(time_t *secs, long *nanos) {
+    struct timespec req = {
+        .tv_sec  = *secs,
+        .tv_nsec = *nanos,
+    };
+    struct timespec rem = {};
+
+    int64_t ret = __petra_syscall2(SYSCALL_NANOSLEEP, (int64_t)&req, (int64_t)&rem);
+
+    // On EINTR the kernel writes the remaining time into rem; propagate it
+    // back so the caller can restart the sleep if desired.
+    *secs  = rem.tv_sec;
+    *nanos = rem.tv_nsec;
+
+    if (ret < 0) {
+        return (int)-ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Pause>::operator()() {
+    sysdep<Sleep>(nullptr, nullptr);
+    return 0;
+}
+
+int Sysdeps<Times>::operator()(struct tms *tms, clock_t *out) {
+    int64_t ret = __petra_syscall1(SYSCALL_TIMES, (int64_t)tms);
+    if (ret < 0) {
+        return -ret;
+    }
+    if (out) {
+        *out = ret;
+    }
+    return 0;
+}
+
+int Sysdeps<GetItimer>::operator()(int which, struct itimerval *curr_value) {
+    (void)which;
+    if (curr_value) {
+        memset(curr_value, 0, sizeof(*curr_value));
+    }
+    return 0;
+}
+
+int Sysdeps<SetItimer>::operator()(int which, const struct itimerval *new_value, struct itimerval *old_value) {
+    (void)which;
+    (void)new_value;
+    if (old_value) {
+        memset(old_value, 0, sizeof(*old_value));
+    }
+    return 0;
+}
+
+} // namespace mlibc
