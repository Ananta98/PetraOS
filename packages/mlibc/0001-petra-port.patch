index 00000000..b6059da8
--- /dev/null
+++ b/sysdeps/petra/generic/generic.cpp
@@ -0,0 +1,728 @@
+#include <bits/ensure.h>
+#include <mlibc/debug.hpp>
+#include <mlibc/all-sysdeps.hpp>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <sys/ioctl.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include <sys/syscall.h>
+#include <sched.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#include <mlibc/tcb.hpp>
+#include <sys/types.h>
+#include <sys/stat.h>
+#include <sys/select.h>
+#include <termios.h>
+#include <poll.h>
+#include <stddef.h>
+#include <sys/utsname.h>
+#include <sys/resource.h>
+
+namespace mlibc {
+
+void Sysdeps<LibcLog>::operator()(const char *message) {
+    ssize_t unused;
+    sysdep<Write>(2, message, strlen(message), &unused);
+    sysdep<Write>(2, "\n", 1, &unused);
+}
+
+void Sysdeps<LibcPanic>::operator()() {
+    ssize_t unused;
+    char const *message = "\n[PetraOS] mlibc panic occurred!\n";
+    sysdep<Write>(2, message, strlen(message), &unused);
+    sysdep<Exit>(1);
+}
+
+[[noreturn]]
+void Sysdeps<Exit>::operator()(int status) {
+    __petra_syscall1(SYSCALL_EXIT, status);
+    __builtin_unreachable();
+}
+
+int Sysdeps<TcbSet>::operator()(void *pointer) {
+    // WRMSR FS_BASE or arch_prctl(ARCH_SET_FS, pointer)
+    int64_t ret = __petra_syscall2(SYSCALL_ARCH_PRCTL, 0x1002 /* ARCH_SET_FS */, (int64_t)pointer);
+    if (ret < 0) {
+        // Fallback: if kernel does not yet support ARCH_PRCTL, don't hard crash immediately
+        return 0;
+    }
+    return 0;
+}
+
+int Sysdeps<AnonAllocate>::operator()(size_t size, void **pointer) {
+    return sysdep<VmMap>(NULL, size, PROT_READ | PROT_WRITE, MAP_ANONYMOUS | MAP_PRIVATE, -1, 0, pointer);
+}
+
+int Sysdeps<AnonFree>::operator()(void *pointer, size_t size) {
+    return sysdep<VmUnmap>(pointer, size);
+}
+
+int Sysdeps<VmMap>::operator()(void *hint, size_t size, int prot, int flags, int fd, off_t offset, void **window) {
+    int64_t ret = __petra_syscall6(SYSCALL_MMAP, (int64_t)hint, size, prot, flags, fd, offset);
+    if (ret < 0) {
+        return -ret;
+    }
+    *window = (void *)ret;
+    return 0;
+}
+
+int Sysdeps<VmUnmap>::operator()(void *pointer, size_t size) {
+    int64_t ret = __petra_syscall2(SYSCALL_MUNMAP, (int64_t)pointer, size);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<VmProtect>::operator()(void *pointer, size_t size, int prot) {
+    int64_t ret = __petra_syscall3(SYSCALL_MPROTECT, (int64_t)pointer, size, prot);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Write>::operator()(int fd, const void *buf, size_t size, ssize_t *bytes_written) {
+    int64_t ret = __petra_syscall3(SYSCALL_WRITE, fd, (int64_t)buf, size);
+    if (ret < 0) {
+        return -ret;
+    }
+    *bytes_written = ret;
+    return 0;
+}
+
+int Sysdeps<Read>::operator()(int fd, void *buf, size_t size, ssize_t *bytes_read) {
+    int64_t ret = __petra_syscall3(SYSCALL_READ, fd, (int64_t)buf, size);
+    if (ret < 0) {
+        return -ret;
+    }
+    *bytes_read = ret;
+    return 0;
+}
+
+int Sysdeps<Open>::operator()(const char *pathname, int flags, mode_t mode, int *fd) {
+    return sysdep<Openat>(AT_FDCWD, pathname, flags, mode, fd);
+}
+
+int Sysdeps<Openat>::operator()(int dirfd, const char *path, int flags, mode_t mode, int *fd) {
+    int64_t ret = __petra_syscall4(SYSCALL_OPENAT, dirfd, (int64_t)path, flags, mode);
+    if (ret < 0) {
+        return -ret;
+    }
+    *fd = ret;
+    return 0;
+}
+
+int Sysdeps<Close>::operator()(int fd) {
+    int64_t ret = __petra_syscall1(SYSCALL_CLOSE, fd);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Seek>::operator()(int fd, off_t offset, int whence, off_t *new_offset) {
+    int64_t ret = __petra_syscall3(SYSCALL_LSEEK, fd, offset, whence);
+    if (ret < 0) {
+        return -ret;
+    }
+    *new_offset = ret;
+    return 0;
+}
+
+int Sysdeps<Isatty>::operator()(int fd) {
+    int64_t ret = __petra_syscall1(SYSCALL_ISATTY, fd);
+    if (ret < 0) {
+        return -ret;
+    }
+    return (ret == 1) ? 0 : ENOTTY;
+}
+
+int Sysdeps<Ioctl>::operator()(int fd, unsigned long request, void *arg, int *result) {
+    int64_t ret = __petra_syscall3(SYSCALL_IOCTL, fd, request, (int64_t)arg);
+    if (ret < 0) {
+        return -ret;
+    }
+    if (result) {
+        *result = ret;
+    }
+    return 0;
+}
+
+pid_t Sysdeps<GetPid>::operator()() {
+    return __petra_syscall0(SYSCALL_GETPID);
+}
+
+pid_t Sysdeps<GetPpid>::operator()() {
+    return __petra_syscall0(SYSCALL_GETPPID);
+}
+
+int Sysdeps<GetPgid>::operator()(pid_t pid, pid_t *pgid) {
+    int64_t ret = __petra_syscall1(SYSCALL_GETPGRP, pid);
+    if (ret < 0) {
+        return -ret;
+    }
+    *pgid = ret;
+    return 0;
+}
+
+int Sysdeps<SetPgid>::operator()(pid_t pid, pid_t pgid) {
+    int64_t ret = __petra_syscall2(SYSCALL_SETPGID, pid, pgid);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+uid_t Sysdeps<GetUid>::operator()() {
+    return __petra_syscall0(SYSCALL_GETUID);
+}
+
+uid_t Sysdeps<GetEuid>::operator()() {
+    return __petra_syscall0(SYSCALL_GETEUID);
+}
+
+gid_t Sysdeps<GetGid>::operator()() {
+    return __petra_syscall0(SYSCALL_GETGID);
+}
+
+gid_t Sysdeps<GetEgid>::operator()() {
+    return __petra_syscall0(SYSCALL_GETEGID);
+}
+
+int Sysdeps<SetUid>::operator()(uid_t id) {
+    int64_t ret = __petra_syscall1(SYSCALL_SETUID, id);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<SetGid>::operator()(gid_t id) {
+    int64_t ret = __petra_syscall1(SYSCALL_SETGID, id);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<SetSid>::operator()(pid_t *sid) {
+    int64_t ret = __petra_syscall0(SYSCALL_SETSID);
+    if (ret < 0) {
+        return -ret;
+    }
+    if (sid) {
+        *sid = ret;
+    }
+    return 0;
+}
+
+int Sysdeps<GetGroups>::operator()(size_t size, gid_t *list, int *ret_count) {
+    int64_t ret = __petra_syscall2(SYSCALL_GETGROUPS, size, (int64_t)list);
+    if (ret < 0) {
+        return -ret;
+    }
+    if (ret_count) {
+        *ret_count = ret;
+    }
+    return 0;
+}
+
+int Sysdeps<GetRlimit>::operator()(int resource, struct rlimit *limit) {
+    int64_t ret = __petra_syscall2(SYSCALL_GETRLIMIT, resource, (int64_t)limit);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<SetRlimit>::operator()(int resource, const struct rlimit *limit) {
+    int64_t ret = __petra_syscall2(SYSCALL_SETRLIMIT, resource, (int64_t)limit);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Access>::operator()(const char *path, int mode) {
+    int64_t ret = __petra_syscall2(SYSCALL_ACCESS, (int64_t)path, mode);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Faccessat>::operator()(int dirfd, const char *path, int mode, int flags) {
+    int64_t ret = __petra_syscall4(SYSCALL_FACCESSAT, dirfd, (int64_t)path, mode, flags);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Umask>::operator()(mode_t mode, mode_t *old) {
+    int64_t ret = __petra_syscall1(SYSCALL_UMASK, mode);
+    if (ret < 0) {
+        return -ret;
+    }
+    if (old) {
+        *old = ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Fork>::operator()(pid_t *child) {
+    int64_t ret = __petra_syscall0(SYSCALL_FORK);
+    if (ret < 0) {
+        return -ret;
+    }
+    *child = ret;
+    return 0;
+}
+
+int Sysdeps<Execve>::operator()(const char *path, char *const argv[], char *const envp[]) {
+    int64_t ret = __petra_syscall3(SYSCALL_EXECVE, (int64_t)path, (int64_t)argv, (int64_t)envp);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Waitpid>::operator()(pid_t pid, int *status, int flags, struct rusage *ru, pid_t *ret_pid) {
+    int64_t ret = __petra_syscall4(SYSCALL_WAIT4, pid, (int64_t)status, flags, (int64_t)ru);
+    if (ret < 0) {
+        return -ret;
+    }
+    *ret_pid = ret;
+    return 0;
+}
+
+int Sysdeps<FutexWait>::operator()(int *pointer, int expected, const struct timespec *time) {
+    int64_t ret = __petra_syscall4(SYSCALL_FUTEX, (int64_t)pointer, 0 /* FUTEX_WAIT */, expected, (int64_t)time);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<FutexWake>::operator()(int *pointer, bool all) {
+    int64_t val = all ? INT_MAX : 1;
+    int64_t ret = __petra_syscall3(SYSCALL_FUTEX, (int64_t)pointer, 1 /* FUTEX_WAKE */, val);
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<ClockGet>::operator()(int clock, time_t *secs, long *nanos) {
+    struct timespec ts;
+    int64_t ret = __petra_syscall2(SYSCALL_CLOCK_GETTIME, clock, (int64_t)&ts);
+    if (ret < 0) {
+        return -ret;
+    }
+    *secs = ts.tv_sec;
+    *nanos = ts.tv_nsec;
+    return 0;
+}
+
+int Sysdeps<Stat>::operator()(fsfd_target fsfdt, int fd, const char *path, int flags, struct stat *statbuf) {
+    int64_t ret;
+    switch (fsfdt) {
+        case fsfd_target::fd:
+            ret = __petra_syscall2(SYSCALL_FSTAT, fd, (int64_t)statbuf);
+            break;
+        case fsfd_target::path:
+            ret = __petra_syscall2(SYSCALL_STAT, (int64_t)path, (int64_t)statbuf);
+            break;
+        case fsfd_target::fd_path:
+            ret = __petra_syscall4(SYSCALL_NEWFSTATAT, fd, (int64_t)path, (int64_t)statbuf, flags);
+            break;
+        default:
+            return EINVAL;
+    }
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Fcntl>::operator()(int fd, int request, va_list args, int *result) {
+    int64_t arg = va_arg(args, int64_t);
+    int64_t ret = __petra_syscall3(SYSCALL_FCNTL, fd, request, arg);
+    if (ret < 0) {
+        return -ret;
+    }
+    if (result) {
+        *result = ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Dup>::operator()(int fd, int flags, int *newfd) {
+    (void)flags;
+    int64_t ret = __petra_syscall1(SYSCALL_DUP, fd);
+    if (ret < 0) {
+        return -ret;
+    }
+    *newfd = ret;
+    return 0;
+}
+
+int Sysdeps<Dup2>::operator()(int fd, int flags, int newfd) {
+    int64_t ret;
+    if (flags) {
+        ret = __petra_syscall3(SYSCALL_DUP3, fd, newfd, flags);
+    } else {
+        ret = __petra_syscall2(SYSCALL_DUP2, fd, newfd);
+    }
+    if (ret < 0) {
+        return -ret;
+    }
+    return 0;
+}
