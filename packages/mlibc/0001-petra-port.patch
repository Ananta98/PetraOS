From 209e5154b51b5e513dd5a7b1e088263fa89ae29c Mon Sep 17 00:00:00 2001
From: Ananta <kusumaananta042@gmail.com>
Date: Fri, 28 Aug 2026 20:55:26 +0700
Subject: [PATCH] feat(sysdeps/petra): implement GetRusage sysdep

---
 sysdeps/petra/generic/generic.cpp       | 13 +++++++++++++
 sysdeps/petra/include/mlibc/sysdeps.hpp |  1 +
 sysdeps/petra/include/sys/syscall.h     |  1 +
 3 files changed, 15 insertions(+)

diff --git a/sysdeps/petra/generic/generic.cpp b/sysdeps/petra/generic/generic.cpp
index 1fcf28da3..db9e4817e 100644
--- a/sysdeps/petra/generic/generic.cpp
+++ b/sysdeps/petra/generic/generic.cpp
@@ -348,6 +348,19 @@ int Sysdeps<SetRlimit>::operator()(int resource, const struct rlimit *limit) {
     return 0;
 }
 
+int Sysdeps<GetRusage>::operator()(int scope, struct rusage *usage) {
+    if (!usage) {
+        return EFAULT;
+    }
+    memset(usage, 0, sizeof(struct rusage));
+    int64_t ret = __petra_syscall2(SYSCALL_GETRUSAGE, scope, (int64_t)usage);
+    if (ret < 0) {
+        // Fallback to 0 if syscall returns error or not supported
+        return 0;
+    }
+    return 0;
+}
+
 int Sysdeps<Access>::operator()(const char *path, int mode) {
     int64_t ret = __petra_syscall2(SYSCALL_ACCESS, (int64_t)path, mode);
     if (ret < 0) {
diff --git a/sysdeps/petra/include/mlibc/sysdeps.hpp b/sysdeps/petra/include/mlibc/sysdeps.hpp
index 385882fa3..c86f1450b 100644
--- a/sysdeps/petra/include/mlibc/sysdeps.hpp
+++ b/sysdeps/petra/include/mlibc/sysdeps.hpp
@@ -77,6 +77,7 @@ struct PetraSysdepTags :
     SetGroups,
     GetRlimit,
     SetRlimit,
+    GetRusage,
     Nice,
     SetPriority,
     ThreadSetname,
diff --git a/sysdeps/petra/include/sys/syscall.h b/sysdeps/petra/include/sys/syscall.h
index b002185bf..0f38fd0ce 100644
--- a/sysdeps/petra/include/sys/syscall.h
+++ b/sysdeps/petra/include/sys/syscall.h
@@ -86,6 +86,7 @@
 #define SYSCALL_UMASK          95
 #define SYSCALL_GETTIMEOFDAY   96
 #define SYSCALL_GETRLIMIT      97
+#define SYSCALL_GETRUSAGE      98
 #define SYSCALL_TIMES          100
 #define SYSCALL_GETUID         102
 #define SYSCALL_GETGID         104
-- 
2.43.0

