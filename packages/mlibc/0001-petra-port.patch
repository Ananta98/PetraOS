+        return -ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Readv>::operator()(int fd, const struct iovec *iovs, int iovc, ssize_t *bytes_read) {
+    int64_t ret = __petra_syscall3(SYSCALL_READV, fd, (int64_t)iovs, iovc);
+    if (ret < 0) {
