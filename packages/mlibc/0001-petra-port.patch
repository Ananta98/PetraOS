+                *ret = SYSCONF_OPEN_MAX_DEFAULT;
+                return 0;
+            }
+            *ret = (ru.rlim_cur == RLIM_INFINITY) ? SYSCONF_OPEN_MAX_DEFAULT : ru.rlim_cur;
+            break;
+        }
+        case _SC_CHILD_MAX: {
+            struct rlimit ru;
+            if(int e = sysdep<GetRlimit>(RLIMIT_NPROC, &ru); e) {
+                *ret = SYSCONF_CHILD_MAX_DEFAULT;
+                return 0;
+            }
+            *ret = (ru.rlim_cur == RLIM_INFINITY) ? SYSCONF_CHILD_MAX_DEFAULT : ru.rlim_cur;
+            break;
+        }
+        case _SC_NPROCESSORS_CONF:
+        case _SC_NPROCESSORS_ONLN: {
+            *ret = SYSCONF_NPROCESSORS_DEFAULT;
+            break;
+        }
+        case _SC_PHYS_PAGES:
+        case _SC_AVPHYS_PAGES: {
+            *ret = SYSCONF_PHYS_PAGES_DEFAULT;
+            break;
+        }
+        case _SC_PAGESIZE: {
+            *ret = SYSCONF_PAGE_SIZE_DEFAULT;
+            break;
+        }
+        case _SC_CLK_TCK: {
+            *ret = SYSCONF_CLK_TCK_DEFAULT;
+            break;
+        }
+        default: {
+            return EINVAL;
+        }
+    }
+    return 0;
+}
+
+int Sysdeps<GetLoadavg>::operator()(double *samples) {
+    if (samples) {
+        samples[0] = 0.0;
+        samples[1] = 0.0;
+        samples[2] = 0.0;
+    }
+    return 0;
+}
+
+int Sysdeps<Nice>::operator()(int nice, int *ret) {
+    (void)nice;
+    if (ret) {
+        *ret = 0;
+    }
+    return 0;
+}
+
+int Sysdeps<SetPriority>::operator()(int which, id_t who, int prio) {
+    (void)which;
+    (void)who;
+    (void)prio;
+    return 0;
+}
+
+#if __MLIBC_LINUX_OPTION
+int Sysdeps<Sysinfo>::operator()(struct sysinfo *info) {
+    if (info) {
+        memset(info, 0, sizeof(*info));
+        info->uptime = DEFAULT_SYSINFO_UPTIME;
+        info->totalram = DEFAULT_SYSINFO_TOTALRAM;
+        info->freeram = DEFAULT_SYSINFO_FREERAM;
+        info->procs = DEFAULT_SYSINFO_PROCS;
+    }
+    return 0;
+}
+#endif // __MLIBC_LINUX_OPTION
+
+#ifndef MLIBC_BUILDING_RTLD
+int Sysdeps<GetEntropy>::operator()(void *buffer, size_t length) {
+    int fd = 0;
+    if (int err = sysdep<Open>("/dev/urandom", O_RDONLY, 0, &fd); err) {
+        return err;
+    }
+    ssize_t bytes_read = 0;
+    int err = sysdep<Read>(fd, buffer, length, &bytes_read);
+    sysdep<Close>(fd);
+    return err;
+}
+#endif /* !MLIBC_BUILDING_RTLD */
+
+} // namespace mlibc
diff --git a/sysdeps/petra/generic/terminal.cpp b/sysdeps/petra/generic/terminal.cpp
new file mode 100644
index 000000000..58b37e107
--- /dev/null
+++ b/sysdeps/petra/generic/terminal.cpp
@@ -0,0 +1,215 @@
+#include <bits/ensure.h>
+#include <mlibc/debug.hpp>
+#include <mlibc/all-sysdeps.hpp>
+#include <errno.h>
+#include <termios.h>
+#include <sys/ioctl.h>
