 namespace mlibc {
 
@@ -990,6 +991,157 @@ int Sysdeps<Shmctl>::operator()(int *idx, int shmid, int cmd, struct shmid_ds *b
     return 0;
 }
 
+int Sysdeps<Socket>::operator()(int family, int type, int protocol, int *fd) {
+    int64_t ret = __petra_syscall3(SYSCALL_SOCKET, family, type, protocol);
+    if (ret < 0) {
+        return (int)(-ret);
+    }
+    if (fd) {
+        *fd = (int)ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Bind>::operator()(int fd, const struct sockaddr *addr_ptr, socklen_t addr_length) {
+    int64_t ret = __petra_syscall3(SYSCALL_BIND, fd, (int64_t)addr_ptr, addr_length);
+    if (ret < 0) {
+        return (int)(-ret);
+    }
+    return 0;
+}
+
+int Sysdeps<Connect>::operator()(int fd, const struct sockaddr *addr_ptr, socklen_t addr_length) {
+    int64_t ret = __petra_syscall3(SYSCALL_CONNECT, fd, (int64_t)addr_ptr, addr_length);
+    if (ret < 0) {
+        return (int)(-ret);
+    }
+    return 0;
+}
+
+int Sysdeps<Listen>::operator()(int fd, int backlog) {
+    int64_t ret = __petra_syscall2(SYSCALL_LISTEN, fd, backlog);
+    if (ret < 0) {
+        return (int)(-ret);
+    }
+    return 0;
+}
+
+int Sysdeps<Accept>::operator()(int fd, int *newfd, struct sockaddr *addr_ptr, socklen_t *addr_length, int flags) {
+    int64_t ret;
+    if (flags != 0) {
+        ret = __petra_syscall4(SYSCALL_ACCEPT4, fd, (int64_t)addr_ptr, (int64_t)addr_length, flags);
+    } else {
+        ret = __petra_syscall3(SYSCALL_ACCEPT, fd, (int64_t)addr_ptr, (int64_t)addr_length);
+    }
+    if (ret < 0) {
+        return (int)(-ret);
+    }
+    if (newfd) {
+        *newfd = (int)ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Sendto>::operator()(int fd, const void *buffer, size_t size, int flags, const struct sockaddr *sock_addr, socklen_t addr_length, ssize_t *length) {
+    int64_t ret = __petra_syscall6(SYSCALL_SENDTO, fd, (int64_t)buffer, size, flags, (int64_t)sock_addr, addr_length);
+    if (ret < 0) {
+        return (int)(-ret);
+    }
+    if (length) {
+        *length = (ssize_t)ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Recvfrom>::operator()(int fd, void *buffer, size_t size, int flags, struct sockaddr *sock_addr, socklen_t *addr_length, ssize_t *length) {
+    int64_t ret = __petra_syscall6(SYSCALL_RECVFROM, fd, (int64_t)buffer, size, flags, (int64_t)sock_addr, (int64_t)addr_length);
+    if (ret < 0) {
+        return (int)(-ret);
+    }
+    if (length) {
+        *length = (ssize_t)ret;
+    }
+    return 0;
+}
+
+int Sysdeps<MsgSend>::operator()(int fd, const struct msghdr *hdr, int flags, ssize_t *length) {
+    int64_t ret = __petra_syscall3(SYSCALL_SENDMSG, fd, (int64_t)hdr, flags);
+    if (ret < 0) {
+        return (int)(-ret);
+    }
+    if (length) {
+        *length = (ssize_t)ret;
+    }
+    return 0;
+}
+
+int Sysdeps<MsgRecv>::operator()(int fd, struct msghdr *hdr, int flags, ssize_t *length) {
+    int64_t ret = __petra_syscall3(SYSCALL_RECVMSG, fd, (int64_t)hdr, flags);
+    if (ret < 0) {
+        return (int)(-ret);
+    }
+    if (length) {
+        *length = (ssize_t)ret;
+    }
+    return 0;
+}
+
+int Sysdeps<Sockname>::operator()(int fd, struct sockaddr *addr_ptr, socklen_t max_addr_length, socklen_t *actual_length) {
+    socklen_t len = max_addr_length;
+    int64_t ret = __petra_syscall3(SYSCALL_GETSOCKNAME, fd, (int64_t)addr_ptr, (int64_t)&len);
+    if (ret < 0) {
+        return (int)(-ret);
+    }
+    if (actual_length) {
+        *actual_length = len;
+    }
+    return 0;
+}
+
+int Sysdeps<Peername>::operator()(int fd, struct sockaddr *addr_ptr, socklen_t max_addr_length, socklen_t *actual_length) {
+    socklen_t len = max_addr_length;
+    int64_t ret = __petra_syscall3(SYSCALL_GETPEERNAME, fd, (int64_t)addr_ptr, (int64_t)&len);
+    if (ret < 0) {
+        return (int)(-ret);
+    }
+    if (actual_length) {
+        *actual_length = len;
+    }
+    return 0;
+}
+
+int Sysdeps<GetSockopt>::operator()(int fd, int layer, int number, void *__restrict buffer, socklen_t *__restrict size) {
+    int64_t ret = __petra_syscall5(SYSCALL_GETSOCKOPT, fd, layer, number, (int64_t)buffer, (int64_t)size);
+    if (ret < 0) {
+        return (int)(-ret);
+    }
+    return 0;
+}
+
+int Sysdeps<SetSockopt>::operator()(int fd, int layer, int number, const void *buffer, socklen_t size) {
+    int64_t ret = __petra_syscall5(SYSCALL_SETSOCKOPT, fd, layer, number, (int64_t)buffer, size);
+    if (ret < 0) {
+        return (int)(-ret);
+    }
+    return 0;
+}
+
+int Sysdeps<Shutdown>::operator()(int sockfd, int how) {
