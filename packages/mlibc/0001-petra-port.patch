+            *ret = (ru.rlim_cur == RLIM_INFINITY) ? 1024 : ru.rlim_cur;
+            break;
+        }
+        case _SC_CHILD_MAX: {
+            struct rlimit ru;
+            if(int e = sysdep<GetRlimit>(RLIMIT_NPROC, &ru); e) {
+                *ret = 4096;
+                return 0;
+            }
+            *ret = (ru.rlim_cur == RLIM_INFINITY) ? 4096 : ru.rlim_cur;
+            break;
+        }
+        case _SC_NPROCESSORS_CONF:
+        case _SC_NPROCESSORS_ONLN: {
+            *ret = 1;
+            break;
+        }
+        case _SC_PHYS_PAGES:
+        case _SC_AVPHYS_PAGES: {
+            *ret = 262144;
+            break;
+        }
+        case _SC_PAGESIZE: {
+            *ret = 4096;
+            break;
+        }
+        case _SC_CLK_TCK: {
+            *ret = 100;
+            break;
+        }
+        default: {
+            return EINVAL;
+        }
+    }
+    return 0;
+}
