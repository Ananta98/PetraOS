+    struct utsname uts;
+    const char *name = "petraos";
+    int64_t ret = __petra_syscall1(SYSCALL_UNAME, (int64_t)&uts);
+    if (ret >= 0 && uts.nodename[0] != '\0') {
+        name = uts.nodename;
+    }
+    size_t len = strlen(name);
+    size_t copy = (len < bufsize) ? len : bufsize - 1;
+    memcpy(buffer, name, copy);
+    buffer[copy] = '\0';
+    return 0;
+}
