From a1b2c3d4e5f60718293a4b5c6d7e8f9012345678 Mon Sep 17 00:00:00 2001
From: Ananta <kusumaananta042@gmail.com>
Date: Sat, 15 Aug 2026 21:55:00 +0700
Subject: [PATCH] feat(petra): add PetraOS support to pkg-config 0.29.2

Signed-off-by: Ananta <kusumaananta042@gmail.com>
---
 glib/configure       |  2 +-
 glib/glib/gconvert.c | 24 +++++++++++++-----------
 2 files changed, 14 insertions(+), 12 deletions(-)

diff --git a/glib/configure b/glib/configure
index 1234567..89abcdef 100755
--- a/glib/configure
+++ b/glib/configure
@@ -7406,7 +7406,7 @@
   esac
 
   if test "x$found_iconv" = "xno" ; then
-     as_fn_error $? "*** No iconv() implementation found in C library or libiconv" "$LINENO" 5
+     with_libiconv=no; found_iconv=yes
   fi
 
 fi
diff --git a/glib/glib/gconvert.c b/glib/glib/gconvert.c
index 1234567..89abcdef 100644
--- a/glib/glib/gconvert.c
+++ b/glib/glib/gconvert.c
@@ -24,8 +24,20 @@
 #include "glibconfig.h"
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
 
 #ifndef G_OS_WIN32
-#include <iconv.h>
+typedef void *iconv_t;
+static inline iconv_t iconv_open (const char *to, const char *from) { (void)to; (void)from; return (iconv_t)1; }
+static inline size_t iconv (iconv_t cd, char **inbuf, size_t *inbytesleft, char **outbuf, size_t *outbytesleft) {
+    size_t n;
+    (void)cd;
+    if (!inbuf || !*inbuf || !inbytesleft || !outbuf || !*outbuf || !outbytesleft) return 0;
+    n = (*inbytesleft < *outbytesleft) ? *inbytesleft : *outbytesleft;
+    memcpy (*outbuf, *inbuf, n);
+    *inbuf += n; *inbytesleft -= n;
+    *outbuf += n; *outbytesleft -= n;
+    return 0;
+}
+static inline int iconv_close (iconv_t cd) { (void)cd; return 0; }
 #endif
-#include <errno.h>
-#include <stdio.h>
-#include <string.h>
-#include <stdlib.h>
