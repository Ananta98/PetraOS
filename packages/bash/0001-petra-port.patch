From e9f191b5c464c208c90353c7a23c6f85e4952673 Mon Sep 17 00:00:00 2001
From: Ananta <kusumaananta042@gmail.com>
Date: Sat, 15 Aug 2026 21:28:00 +0700
Subject: [PATCH] feat(petra): add PetraOS support to GNU Bash 5.2

Signed-off-by: Ananta <kusumaananta042@gmail.com>
---
 externs.h          | 2 +-
 lib/sh/random.c    | 4 ++++
 subst.c            | 1 +
 support/config.sub | 1 +
 support/shobj-conf | 4 ++++
 5 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/externs.h b/externs.h
index 47b80f6..063912f 100644
--- a/externs.h
+++ b/externs.h
@@ -308,7 +308,7 @@ extern int getdtablesize (void);
 #endif /* !HAVE_GETDTABLESIZE */
 
 #if !defined (HAVE_GETHOSTNAME)
-extern int gethostname (char *, int);
+extern int gethostname (char *, size_t);
 #endif /* !HAVE_GETHOSTNAME */
 
 extern int getmaxgroups (void);
diff --git a/lib/sh/random.c b/lib/sh/random.c
index a1b2c3d..e4f5a6b 100644
--- a/lib/sh/random.c
+++ b/lib/sh/random.c
@@ -26,6 +26,10 @@
 #  include <sys/random.h>
 #endif
 
+#ifndef GRND_NONBLOCK
+#  define GRND_NONBLOCK 0x0001
+#endif
+
 #if defined (HAVE_UNISTD_H)
 #  include <unistd.h>
 #endif
diff --git a/subst.c b/subst.c
index e9d3e75..f787665 100644
--- a/subst.c
+++ b/subst.c
@@ -32,6 +32,7 @@
 #endif
 #include <signal.h>
 #include <errno.h>
+#include <limits.h>
 
 #if defined (HAVE_UNISTD_H)
 #  include <unistd.h>
diff --git a/support/config.sub b/support/config.sub
index 1754a1b..1754c2d 100755
--- a/support/config.sub
+++ b/support/config.sub
@@ -1754,6 +1754,7 @@ case $os in
 	     | onefs* | tirtos* | phoenix* | fuchsia* | redox* | bme* \
 	     | midnightbsd* | amdhsa* | unleashed* | emscripten* | wasi* \
 	     | nsk* | powerunix* | genode* | zvmoe* | qnx* | emx* | zephyr* \
+	     | petra* \
 	     | fiwix* )
 		;;
 	# This one is extra strict with allowed versions
diff --git a/support/shobj-conf b/support/shobj-conf
index c3df351..0576089 100755
--- a/support/shobj-conf
+++ b/support/shobj-conf
@@ -79,6 +79,10 @@ nsk-cc-tandem|nsk-c99-tandem)
 	SHOBJ_LDFLAGS='-shared -bglobalized -unres_symbols ignore'
 	;;
 
+petra*-*gcc*)
+	SHOBJ_CFLAGS=-fpic
+	;;
+
 sunos4*-*gcc*)
 	SHOBJ_CFLAGS=-fpic
 	SHOBJ_LD=/usr/bin/ld
-- 
2.43.0
