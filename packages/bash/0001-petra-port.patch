From b7218c8f3e8a945facecf49418ca0e41fc9d92d8 Mon Sep 17 00:00:00 2001
From: Ananta <kusumaananta042@gmail.com>
Date: Mon, 14 Sep 2026 21:05:48 +0700
Subject: [PATCH] feat(petra): add PetraOS support to GNU Bash 5.3

---
 externs.h          | 2 +-
 subst.c            | 1 +
 support/config.sub | 1 +
 support/shobj-conf | 4 ++++
 4 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/externs.h b/externs.h
index 47b80f6..063912f 100644
--- a/externs.h
+++ b/externs.h
@@ -308,7 +308,7 @@ extern int getdtablesize (void);
 #endif /* !HAVE_GETDTABLESIZE */
 
 #if !defined (HAVE_GETHOSTNAME)
-extern int gethostname (char *, int);
+extern int gethostname (char *, size_t);
 #endif /* !HAVE_GETHOSTNAME */
 
 extern int getmaxgroups (void);
diff --git a/subst.c b/subst.c
index e9d3e75..f787665 100644
--- a/subst.c
+++ b/subst.c
@@ -32,6 +32,7 @@
 #endif
 #include <signal.h>
 #include <errno.h>
+#include <limits.h>
 
 #if defined (HAVE_UNISTD_H)
 #  include <unistd.h>
diff --git a/support/config.sub b/support/config.sub
index 4aaae46..a879c30 100644
--- a/support/config.sub
+++ b/support/config.sub
@@ -2082,6 +2082,7 @@ case $os in
 	| oskit* \
 	| osx* \
 	| palmos* \
+	| petra* \
 	| phoenix* \
 	| plan9* \
 	| powermax* \
diff --git a/support/shobj-conf b/support/shobj-conf
index c3df351..5be5af9 100755
--- a/support/shobj-conf
+++ b/support/shobj-conf
@@ -79,6 +79,10 @@ nsk-cc-tandem|nsk-c99-tandem)
 	SHOBJ_LDFLAGS='-shared -bglobalized -unres_symbols ignore'
 	;;
 
+petra*-*gcc*)
+	SHOBJ_CFLAGS=-fpic
+	;;
+
 sunos4*-*gcc*)
 	SHOBJ_CFLAGS=-fpic
 	SHOBJ_LD=/usr/bin/ld
-- 
2.43.0

